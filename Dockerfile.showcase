# Creatly — сборка для отдельного стенда витрин (docker-compose.showcase.yml).
# Отличия от Dockerfile: обычный `next start` (в next.config нет output:"standalone"), Debian вместо Alpine
# (sharp/prisma без musl-сюрпризов), public/uploads в образ не входит — монтируется томом (гигабайты ассетов).
FROM node:22-bookworm-slim AS base
RUN apt-get update && apt-get install -y --no-install-recommends openssl ca-certificates && rm -rf /var/lib/apt/lists/*
ENV NEXT_TELEMETRY_DISABLED=1 PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1

FROM base AS deps
WORKDIR /app
COPY package.json package-lock.json ./
COPY prisma ./prisma/
RUN npm ci --no-audit --no-fund
RUN npx prisma generate

FROM base AS builder
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY . .
# модули читают SESSION_SECRET/DATABASE_URL при импорте — на сборке заглушки, реальные значения — в рантайме
ENV SESSION_SECRET=build-time-placeholder-secret-not-used-at-runtime \
    DATABASE_URL=postgresql://build:build@127.0.0.1:5432/build \
    NODE_OPTIONS=--max-old-space-size=4096
RUN npm run build

FROM base AS runner
WORKDIR /app
ENV NODE_ENV=production PORT=3000 HOSTNAME=0.0.0.0
COPY --from=builder /app ./
EXPOSE 3000
CMD ["sh", "-c", "npx prisma migrate deploy && npx next start -p 3000 -H 0.0.0.0"]
